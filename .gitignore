# ============================================================
# General Purpose Event & Timeline Intelligence Platform
# .gitignore
# ============================================================

# --- OS files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Editor/IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.editorconfig.local

# --- Environment / secrets ---
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# --- SQLite databases (do not commit real data) ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data/

# --- Go ---
backend/bin/
backend/vendor/
*.test
*.out
# Keep go.sum (important for reproducibility)

# --- Node / npm / Svelte / Vite ---
frontend/node_modules/
frontend/dist/
frontend/.svelte-kit/
frontend/build/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
build_artifacts/

# --- Build artifacts ---
dist/
build/
*.tar.gz
*.zip

# --- Logs ---
logs/
*.log

# --- Temporary files ---
tmp/
temp/
.tmp/

# --- Build menu state / process tracking ---
.build_mode
.build_pids
logs/
.go/
