# Backend environment configuration
# Copy this file to .env and adjust values for your environment.
# Never commit .env to version control.

# Server
SERVER_PORT=8080
SERVER_HOST=127.0.0.1

# Database
DB_PATH=./data/timeline.db

# Session
# Generate a strong random secret: openssl rand -hex 32
SESSION_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Build mode: debug | release
BUILD_MODE=debug

# Argon2id parameters (OWASP minimum: time=2, memory=65536, threads=4)
ARGON2_TIME=2
ARGON2_MEMORY=65536
ARGON2_THREADS=4
ARGON2_KEY_LEN=32

# Rate limiting
# Max failed attempts before progressive delay kicks in
RATE_LIMIT_MAX_ATTEMPTS=5
# Base delay in seconds for first failed attempt
RATE_LIMIT_BASE_DELAY_SECONDS=1

# Session expiry
SESSION_EXPIRY_HOURS=24

# CSRF
CSRF_TOKEN_EXPIRY_MINUTES=60

# Logging
LOG_LEVEL=debug
LOG_FORMAT=console
